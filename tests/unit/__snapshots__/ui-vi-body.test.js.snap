exports[`snapshot ruột phòng/view [vi] > artist.actor 1`] = `
"<button class="x" onclick="closeM()" aria-label="Đóng">✕</button><div class="big"><div class="bigwrap"><div class="chibi big" style="--d:-0.2s"><div class="cw"><div class="cb"><div class="shd"></div><div class="po" style="background:#e86a92"></div><div class="lg l"></div><div class="lg r"></div><div class="ar l" style="--o:#16b98f;--s:#d9a27c"></div><div class="ar r" style="--o:#16b98f;--s:#d9a27c"></div><div class="bd" style="background:#16b98f"><i></i></div><div class="hd" style="background:#d9a27c"><div class="hf" style="background:#e86a92"></div><i class="e l"></i><i class="e r"></i><i class="bl l"></i><i class="bl r"></i><i class="mo"></i></div></div></div></div></div><div><h2>Duy Khánh</h2><div><span class="tag p">Solo</span><span class="tag m">Diễn viên</span><span class="tag r">Scandal</span><span class="tag r">📄 HĐ còn 1t</span></div><div class="small muted">Nam, 16 tuổi · Năng khiếu: Vocal · Tố chất x0.85</div></div></div>
  <div class="grid2" style="margin:10px 0"><div class="card">💗 <b>23.1K</b> fan<br><span class="small muted">Danh tiếng 15/100</span></div><div class="card">⚡ Năng lượng <b>92</b><br>🙂 Tâm trạng <b class="">55</b></div><div class="card">💵 Lương <b>4 tr</b>/tuần<br><span class="small muted">Đang: Ký Ức Không Tên (5 tuần)</span></div></div>
  <div class="card small">📋 Quản lý công ty: <span class="muted">Chưa có. Tuyển ở Văn phòng Quản lý (tầng 6).</span></div>
  <div class="card tg">🚨 <b>Tin đồn chèn ép đồng nghiệp</b> · mức 2 · còn 6 tuần. Xử lý ở Phòng Truyền thông.</div>
  
  
  <div class="card small">📄 <b>Hợp đồng:</b> còn 1 tuần · doanh thu mang về 289 tr <button class="btn sm" onclick="view(()=>viewRenew(404))">Đánh giá tái ký</button><br>👩‍🏫 <b>Dẫn dắt TTS (0/2):</b> <span class="muted">chưa có</span> <select onchange="if(this.value)setMentor(+this.value,404)"><option value="">+ Nhận TTS…</option><option value="725">Đức Anh (+12)</option><option value="726">Bảo Long (+9)</option></select></div>
  <div class="card small">📋 <b>Đánh giá định kỳ:</b> kỳ trước <b>Xuất sắc</b> · không đạt liên tiếp <b class="">0/10</b> · kỳ tới sau 4 tuần</div>
  <div class="card small">🙋 <b>Duy Khánh đề xuất dẫn dắt:</b> Đức Anh (+12) <button class="btn sm" onclick="setMentor(725,404)">Đồng ý</button></div><div class="card small">🌐 <b>Quan hệ ngoài công ty:</b> Zen Lâm (Galaxy Star) <b class="good">+18</b> · Mia Cao (Hoa Mai Music) <b class="">0</b> · Leo Phạm (Titan Media) <b class="bad">-8</b></div>
  <h3>Chỉ số</h3><div class="bars"><span>Vocal</span><div class="bar"><i style="width:96.71%"></i></div><b>97</b><span>Nhảy</span><div class="bar"><i style="width:23.3%"></i></div><b>23</b><span>Rap</span><div class="bar"><i style="width:32%"></i></div><b>32</b><span>Diễn xuất</span><div class="bar"><i style="width:38.8%"></i></div><b>39</b><span>Tạp kỹ</span><div class="bar"><i style="width:25%"></i></div><b>25</b><span>Visual</span><div class="bar"><i style="width:21.1%"></i></div><b>21</b><span>Thể lực</span><div class="bar"><i style="width:12.4%"></i></div><b>12</b></div>
  <h3>Lịch tập tuần</h3><div class="row"><span class="dmini" title="T2: Vocal, T3: Vocal, T4: Vocal, T5: Vocal, T6: Vocal, T7: Nghỉ ngơi, CN: Nghỉ ngơi">🎤🎤🎤🎤🎤🛌🛌</span><button class="btn sm" onclick="startPlanOne(404)">Sửa</button><span class="small muted">5 ngày tập · chi phí 3 tr/tuần</span></div>
  <details class="cl" ontoggle="togD('ap-rel',this.open)"><summary>Quan hệ nội bộ</summary><div class="clb"><div class="small">An Nhiên: <b class="good">38</b> </div><div class="small">Khánh Vy: <b class="good">7</b> </div><div class="small">An Khang: <b class="good">6</b> </div><div class="small">Gia Hân: <b class="good">3</b> </div><div class="small">Bảo Long: <b class="good">3</b> </div></div></details>
  <details class="cl" ontoggle="togD('ap-par',this.open)"><summary>Đối tác &amp; bạn diễn</summary><div class="clb"><div class="small">🏢 NetPhim (1 lần, quan hệ 31), Đài VTX (1 lần, quan hệ 26)</div><div class="small">🎭 Tôn Đức Thịnh 37</div></div></details>
  <details class="cl" ontoggle="togD('ap-les',this.open)"><summary>Bài học rút ra</summary><div class="clb"><div class="card small"><b>Phim truyền hình «Cánh Diều Phía Trước»</b> (N3)<br>Phối hợp ăn ý hơn với bạn diễn · <span class="good">Diễn xuất +4.6, Visual +1.1</span></div><div class="card small"><b>Web drama «Ký Ức Tan Vỡ»</b> (N3)<br>Diễn tự nhiên, gần gũi hơn · <span class="good">Diễn xuất +3.1, Visual +1.0</span></div></div></details>
  <details class="cl" ontoggle="togD('ap-his',this.open)"><summary>Lịch sử</summary><div class="clb"><div class="small">N3: Phim truyền hình «Cánh Diều Phía Trước» – Tốt<br>N3: Web drama «Ký Ức Tan Vỡ» – Chưa tốt</div></div></details>
  <div class="row" style="margin-top:16px"><span class="sp"></span><button class="btn warn" onclick="fire(404,this)">Chấm dứt hợp đồng</button></div>"
`;

