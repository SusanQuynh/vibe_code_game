    <div class="small" style="margin-top:6px">Hợp tác cùng (tối đa 2 nghệ sĩ trong công ty):</div><div class="list"><label><input type="checkbox" class="wco" value="9" onchange="wPrev()"> <span style="flex:1"><b>Tuệ Lâm</b> <span class="small muted">bút lực 22 · V4 R27</span></span></label><label><input type="checkbox" class="wco" value="8" onchange="wPrev()"> <span style="flex:1"><b>Cát Tường</b> <span class="small muted">bút lực 21 · V9 R14</span></span></label></div>
    <div class="small muted" id="wPrev" style="margin:6px 0">Chất lượng dự kiến <b>8–28</b>/100</div><button class="btn pink" onclick="writeSong()">Bắt đầu sáng tác</button></div></details>
  
  <button class="btn" style="margin-top:8px" onclick="openRoom('studio')">← Phòng Thu âm</button>"
`;

exports[`snapshot ruột phòng/view [vi] > trendBar 1`] = `"🔥 Thịnh hành: <b>Hip-hop, Retro</b> <span class="muted">· ❄️ EDM · còn 2 tuần</span> · ⚔️ 1 đối thủ comeback"`;
