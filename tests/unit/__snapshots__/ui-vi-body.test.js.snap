exports[`snapshot ruột phòng/view [vi] > artist.trainee 1`] = `
"<button class="x" onclick="closeM()" aria-label="Đóng">✕</button><div class="big"><div class="bigwrap"><div class="chibi big" style="--d:-0.8s"><div class="cw"><div class="cb"><div class="shd"></div><div class="po" style="background:#c98b4b"></div><div class="lg l"></div><div class="lg r"></div><div class="ar l" style="--o:#9b5de5;--s:#f8d0b0"></div><div class="ar r" style="--o:#9b5de5;--s:#f8d0b0"></div><div class="bd" style="background:#9b5de5"><i></i></div><div class="hd" style="background:#f8d0b0"><div class="hf" style="background:#c98b4b"></div><i class="e l"></i><i class="e r"></i><i class="bl l"></i><i class="bl r"></i><i class="mo"></i></div></div></div></div></div><div><h2>Đức Anh</h2><div><span class="tag">Thực tập sinh</span><span class="tag s">🎊 Chừa lịch debut</span></div><div class="small muted">Nam, 19 tuổi · Năng khiếu: Diễn xuất · Tố chất x0.88</div></div></div>
  <div class="grid2" style="margin:10px 0"><div class="card">💗 <b>0</b> fan<br><span class="small muted">Danh tiếng 0/100</span></div><div class="card">⚡ Năng lượng <b>100</b><br>🙂 Tâm trạng <b class="">62</b></div><div class="card">💵 Lương <b>1 tr</b>/tuần<br><span class="small muted">Đang: Cuộc thi «Đấu trường Rap Trẻ» (1 tuần)</span></div></div>
  <div class="card small">📋 Quản lý công ty: <b>Trần Kim Oanh</b> (cấp 1) · Đàm phán 5 · Chăm sóc 1 · Truyền thông 1 · Kế hoạch 1</div>
  
  
  <div class="card small">🎯 <b>Hướng debut:</b> 🎤 Solo — Vocal 68 đủ nổi bật để đứng sân khấu một mình, hợp concept Ballad 56%.</div>
  <div class="card small">👩‍🏫 <b>Tiền bối dẫn dắt:</b> <select onchange="setMentor(725,this.value)" aria-label="Tiền bối dẫn dắt"><option value="0">— Chưa có tiền bối —</option><option value="431">💡 An Nhiên (+13)</option><option value="404">Duy Khánh (+12)</option><option value="666">Gia Hân (+6)</option><option value="701">An Khang (+3)</option><option value="724">Khánh Vy (+0)</option></select><br><span class="muted">Tập nhanh hơn ở kỹ năng tiền bối giỏi hơn (tối đa +40%).</span><br>🎊 <b>Đủ điều kiện debut.</b> Đang chừa lịch, không nhận dự án ngoài. <button class="btn sm" onclick="toggleHold(725)">Mở lịch nhận dự án</button></div>
  <div class="card small">📋 <b>Đánh giá định kỳ:</b> kỳ trước <b>Đạt</b> · không đạt liên tiếp <b class="">0/5</b> · tiến bộ kỳ này 3.5% (cần &gt;20%) · kỳ tới sau 4 tuần</div>
