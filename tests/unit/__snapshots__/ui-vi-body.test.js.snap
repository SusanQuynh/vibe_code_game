exports[`snapshot ruột phòng/view [vi] > room.pr.new 1`] = `
"<button class="x" onclick="closeM()" aria-label="Đóng">✕</button><h2>📰 Phòng Truyền thông</h2><div class="sub">Mỗi ngày tập tăng Tạp kỹ, tốn khoảng 2 năng lượng và 600k. Năng lượng dưới 25 thì tập kém hiệu quả.</div><details class="cl" open="" ontoggle="togD('pr-plan',this.open)"><summary>📣 Kế hoạch quảng bá đề xuất (1)</summary><div class="clb"><div class="small muted" style="margin-bottom:6px">Phòng Truyền thông đề xuất dựa trên lịch comeback, tin đồn và mức độ chú ý của từng nhóm, solo, diễn viên. Kỹ năng Truyền thông cao nhất trong đội quản lý: <b>0</b> (+0% hiệu quả).</div><div class="card prp "><div class="row"><b>🎥 Clip đời sống thực tập sinh (tất cả 2 thực tập sinh)</b><span class="sp"></span><span class="small muted">8 tr</span></div><div class="small muted">Xây fan cho cả lứa trước khi debut, các bạn cũng vui hơn.</div><div class="row" style="margin-top:6px"><span class="sp"></span><button class="btn sm pri" onclick="prGo(this)" data-t="Clip đời sống thực tập sinh (tất cả 2 thực tập sinh)" data-go="prDo('tts','tts')">Duyệt</button></div></div></div></details><details class="cl" ontoggle="togD('pr-sc',this.open)"><summary>🚨 Scandal đang diễn ra (0)</summary><div class="clb"><div class="card small muted">Không có scandal nào. Truyền thông đang êm đẹp.</div>
