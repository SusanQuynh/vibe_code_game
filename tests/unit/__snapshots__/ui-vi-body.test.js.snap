exports[`snapshot ruột phòng/view [vi] > room.mgr.new 1`] = `
"<button class="x" onclick="closeM()" aria-label="Đóng">✕</button><h2>📋 Văn phòng Quản lý</h2><div class="sub">Chạm vào từng mục để mở hoặc thu gọn.</div>
    <div class="row" style="margin-bottom:4px"><button class="btn pri" onclick="view(viewReport)" disabled="">📑 Báo cáo tuần trước</button><button class="btn" onclick="setPropNext(null);view(viewProps)">📋 Đề xuất tuần này</button></div>
    <label class="small row"><input type="checkbox" checked="" onchange="S.repOn=this.checked;save()"> Tự hiện báo cáo sau mỗi tuần</label>
    <label class="small row"><input type="checkbox" checked="" onchange="S.autoAppr=this.checked;save()"> Tự duyệt đề xuất không xung đột của quản lý báo cáo trực tiếp cho bạn</label>
    <div class="card small">🌱 Lứa 1 chưa có quản lý. Quản lý thực tập sinh giờ phụ trách theo từng lứa.</div>
    <details class="cl" ontoggle="togD('mg-help',this.open)"><summary>ℹ️ Cách quản lý hoạt động</summary><div class="clb"><div class="small"><b>Đàm phán:</b> +4% thù lao và giảm 1,5% yêu cầu mỗi điểm<br><b>Chăm sóc:</b> Tăng tâm trạng, giảm hao năng lượng, giảm nguy cơ đòi rời đi<br><b>Truyền thông:</b> Giảm nguy cơ scandal, xử lý scandal hiệu quả hơn<br><b>Kế hoạch:</b> +4% hiệu quả luyện tập mỗi điểm<br><b>Phụ trách:</b> một nhóm, một lứa thực tập sinh, một nghệ sĩ, hoặc danh sách tối đa 4 nghệ sĩ solo/diễn viên. Quản lý có thể kèm cặp các quản lý khác qua mục "Báo cáo cho".<br><b>Ưu tiên:</b> khi tự nhận việc, quản lý luôn ưu tiên dự án mời đích danh nghệ sĩ mình phụ trách.<br><b>Tình huống:</b> quản lý sẽ báo lên các tình huống với nghệ sĩ/TTS kèm nhiều phương án; kỹ năng quản lý quyết định tỉ lệ thành công. Quản lý cũng đề xuất tuyển trợ lý (tăng kỹ năng) và giới thiệu người có năng khiếu làm TTS.<br><b>Lịch tập:</b> "Đề xuất" gửi lịch cho bạn duyệt mỗi tuần, "Tự xếp" áp dụng luôn.<br><b>Tự nhận lời mời:</b> chọn lời mời trả cao nhất, biết ghép nhiều người vào một dự án.<br><b>Luồng duyệt:</b> đề xuất được báo cáo lên cấp trên. Không xung đột thì cấp trên duyệt ngay. Xung đột (trùng người, tranh lời mời, quá sức, bạn diễn mâu thuẫn, scandal) thì chuyển lên người cao hơn có kỹ năng Kế hoạch + cấp đủ cao (≥ 3, 6, 9 theo độ khó), cuối cùng là Giám đốc.<br><b>Cấp bậc:</b> cấp dưới được cộng 20% kỹ năng cấp trên, cấp trên nhận một nửa kinh nghiệm cấp dưới. Mỗi trưởng nhóm quản được 2 người, cứ 2 cấp thêm 1.</div></div></details>
    
    <details class="cl" open="" ontoggle="togD('mg-tree',this.open)"><summary>🌳 Sơ đồ tổ chức</summary><div class="clb"><div class="tree"><div class="tnode ceo"><span style="font-size:24px;padding:0 6px">👔</span><div><b>Giám đốc (bạn)</b><div class="small muted">0 quản lý · 2 nghệ sĩ báo cáo trực tiếp</div></div></div><div class="small muted" style="margin:6px 0 0 20px">Chưa có quản lý.</div></div></div></details>
    <div class="row" style="margin:12px 0 0"><h3 style="margin:0">Đội ngũ quản lý theo cấp (0)</h3><span class="sp"></span></div>
    <div class="card small muted">Chưa có quản lý nào. Tuyển ứng viên bên dưới.</div>
    <details class="cl" open="" ontoggle="togD('mg-free',this.open)"><summary>Chưa có quản lý (1)</summary><div class="clb"><div class="small">🌱 <b>2 thực tập sinh</b> — giao quản lý theo lứa</div></div></details>
    <details class="cl" open="" ontoggle="togD('mg-pool',this.open)"><summary>Ứng viên quản lý (3)</summary><div class="clb"><div class="small muted" style="margin-bottom:6px">Danh sách mới mỗi 8 tuần.</div><div class="card"><div class="row"><div class="chibi mini"><div class="cw"><div class="cb"><div class="shd"></div><div class="lg l"></div><div class="lg r"></div><div class="ar l" style="--o:#5b6b8c;--s:#eebf98"></div><div class="ar r" style="--o:#5b6b8c;--s:#eebf98"></div><div class="bd" style="background:#5b6b8c"><i></i></div><div class="hd" style="background:#eebf98"><div class="hf spk" style="background:#3a7d5c"></div><i class="e l"></i><i class="e r"></i><i class="bl l"></i><i class="bl r"></i><i class="mo"></i></div></div></div></div><div><b>Vũ Quốc Huy</b><div class="small muted">Giỏi nhất: Truyền thông · Lương 6 tr/tuần</div></div><span class="sp"></span><button class="btn sm pri" onclick="hireMgr(5)">Tuyển (57 tr)</button></div><div class="bars"><span>Đàm phán</span><div class="bar"><i style="width:50%"></i></div><b>5</b><span>Chăm sóc</span><div class="bar"><i style="width:30%"></i></div><b>3</b><span>Truyền thông</span><div class="bar"><i style="width:80%"></i></div><b>8</b><span>Kế hoạch</span><div class="bar"><i style="width:30%"></i></div><b>3</b></div></div><div class="card"><div class="row"><div class="chibi mini"><div class="cw"><div class="cb"><div class="shd"></div><div class="lg l"></div><div class="lg r"></div><div class="ar l" style="--o:#7a7f8c;--s:#d9a27c"></div><div class="ar r" style="--o:#7a7f8c;--s:#d9a27c"></div><div class="bd" style="background:#7a7f8c"><i></i></div><div class="hd" style="background:#d9a27c"><div class="hf" style="background:#8a6cff"></div><i class="e l"></i><i class="e r"></i><i class="bl l"></i><i class="bl r"></i><i class="mo"></i></div></div></div></div><div><b>Đặng Quốc Huy</b><div class="small muted">Giỏi nhất: Chăm sóc · Lương 5 tr/tuần</div></div><span class="sp"></span><button class="btn sm pri" onclick="hireMgr(6)">Tuyển (54 tr)</button></div><div class="bars"><span>Đàm phán</span><div class="bar"><i style="width:50%"></i></div><b>5</b><span>Chăm sóc</span><div class="bar"><i style="width:70%"></i></div><b>7</b><span>Truyền thông</span><div class="bar"><i style="width:30%"></i></div><b>3</b><span>Kế hoạch</span><div class="bar"><i style="width:30%"></i></div><b>3</b></div></div><div class="card"><div class="row"><div class="chibi mini"><div class="cw"><div class="cb"><div class="shd"></div><div class="lg l"></div><div class="lg r"></div><div class="ar l" style="--o:#5b6b8c;--s:#d9a27c"></div><div class="ar r" style="--o:#5b6b8c;--s:#d9a27c"></div><div class="bd" style="background:#5b6b8c"><i></i></div><div class="hd" style="background:#d9a27c"><div class="hf" style="background:#4aa3df"></div><i class="e l"></i><i class="e r"></i><i class="bl l"></i><i class="bl r"></i><i class="mo"></i></div></div></div></div><div><b>Hoàng Văn Hải</b><div class="small muted">Giỏi nhất: Truyền thông · Lương 4 tr/tuần</div></div><span class="sp"></span><button class="btn sm pri" onclick="hireMgr(7)">Tuyển (39 tr)</button></div><div class="bars"><span>Đàm phán</span><div class="bar"><i style="width:10%"></i></div><b>1</b><span>Chăm sóc</span><div class="bar"><i style="width:50%"></i></div><b>5</b><span>Truyền thông</span><div class="bar"><i style="width:30%"></i></div><b>3</b><span>Kế hoạch</span><div class="bar"><i style="width:40%"></i></div><b>4</b></div></div><button class="btn" onclick="rehuntMgr()">Tìm ứng viên mới (15 tr)</button></div></details>"
`;

