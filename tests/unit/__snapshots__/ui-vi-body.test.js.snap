exports[`snapshot ruột phòng/view [vi] > room.acting.new 1`] = `
"<button class="x" onclick="closeM()" aria-label="Đóng">✕</button><h2>🎬 Phòng Diễn xuất</h2><div class="sub">Mỗi ngày tập tăng Diễn xuất, tốn khoảng 4 năng lượng và 600k. Năng lượng dưới 25 thì tập kém hiệu quả.</div>
    <h3>🎬 Tự sản xuất phim</h3><div class="card"><div class="row"><select id="fGen"><option value="romance">Tình cảm</option><option value="action">Hành động</option><option value="horror">Kinh dị</option><option value="comedy">Hài</option><option value="historical">Cổ trang</option><option value="drama">Tâm lý</option><option value="musical">Âm nhạc</option></select><select id="fBud"><option value="300000000">Kinh phí thấp – 300 tr</option><option value="800000000">Trung bình – 800 tr</option><option value="2000000000">Bom tấn – 2 tỷ</option></select></div>
    <input type="text" id="fTitle" placeholder="Tên phim (tuỳ chọn)" style="width:100%;margin-top:6px">
    <div class="small" style="margin-top:6px">Chọn 1–3 vai chính (quay 8 tuần, ra rạp sau 2 tuần hậu kỳ):</div>
    <div class="list" id="fList"><div class="small muted">Không có nghệ sĩ đã ra mắt nào rảnh.</div></div>
    <button class="btn pink" style="margin-top:6px" onclick="produceFilm()">Bấm máy</button></div>
